{
  "name": "christmas-world-seoul",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "CHRISTMAS WORLD SEOUL - 3D social metaverse (Three.js + WebSocket + WebRTC)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
